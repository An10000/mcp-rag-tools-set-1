# rag-mcp setup creates .env with generated database passwords and the model digest.
# Existing process environment takes precedence. Values are literal, one per line.
TAVILY_API_KEY=
POSTGRES_PASSWORD=replace-with-local-admin-password
POSTGRES_READER_PASSWORD=replace-with-local-reader-password
POSTGRES_PORT=5432
DATABASE_ADMIN_URL=postgresql://rag_admin:replace-with-local-admin-password@127.0.0.1:5432/rag_memory
DATABASE_URL=postgresql://rag_reader:replace-with-local-reader-password@127.0.0.1:5432/rag_memory
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_REVISION=filled-by-setup-from-model-digest
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT=120
